{
  "name": "open-pantry",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build && vite build --config vite.migrate.config.ts",
    "preview": "vite preview",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run --passWithNoTests",
    "db:up": "docker compose up -d db",
    "check": "oxfmt --check && oxlint --deny-warnings && tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "auth:generate": "pnpm dlx auth@1.7.12 generate --config src/domains/auth/auth.ts --output src/db/auth-schema.ts --yes"
  },
  "dependencies": {
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "1.169.4",
    "better-auth": "1.7.12",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^1.61.0",
    "nitro": "3.0.260610-beta",
    "pg": "^8.16.3",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "0.8.5",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.11",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^6.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.11.2"
}
