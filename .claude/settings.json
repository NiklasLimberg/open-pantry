{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "file=$(node -p \"JSON.parse(require('fs').readFileSync(0, 'utf8')).tool_input.file_path\"); \"$CLAUDE_PROJECT_DIR/node_modules/.bin/oxlint\" --fix --no-error-on-unmatched-pattern \"$file\"; \"$CLAUDE_PROJECT_DIR/node_modules/.bin/oxfmt\" --no-error-on-unmatched-pattern \"$file\"",
            "statusMessage": "Linting and formatting"
          }
        ]
      }
    ]
  }
}
